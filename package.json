{
  "name": "zenitring",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "bun --bun vite dev --host 0.0.0.0 --port 3000 --strictPort",
    "build": "bun --bun vite build",
    "preview": "bun --bun vite preview --host 0.0.0.0 --port 3000",
    "start": "bun build/index.js",
    "prepare": "svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "5.5.7",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@tailwindcss/vite": "4.3.4",
    "@types/node": "24.19.2",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "tailwindcss": "4.3.4",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
