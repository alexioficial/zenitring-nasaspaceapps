# Copy to .env. Core app uses Bun SQLite; PostgreSQL is an optional profile.
MISSION_DB_PATH=data/zenit.sqlite
POSTGRES_DB=zenitring
POSTGRES_USER=zenitring
# Use URL-safe characters (for example, a random hexadecimal password).
POSTGRES_PASSWORD=local_dev_change_me
POSTGRES_PORT=5432
APP_PORT=3000
# Exact public HTTPS origin in production; use your LAN IP for multi-device demos.
ORIGIN=http://localhost:3000

# Optional server-side explanations of simulated telemetry
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Used only when the astronaut requests a deeper explanation.
GEMINI_DETAIL_MODEL=gemini-3.1-pro-preview
